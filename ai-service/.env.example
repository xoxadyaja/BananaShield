AI_MODE=mock
AI_SERVICE_TOKEN=change-me
# Mock choices: auto, healthy_banana, black_sigatoka, fusarium_wilt,
# banana_bunchy_top_disease, inconclusive
MOCK_SCENARIO=auto
MODEL_PATH=model_files/efficientnet_b0.keras
MODEL_VERSION=efficientnet-b0-demo-v0.2
CONFIDENCE_THRESHOLD=0.75

# Plant-part detection is independent from EfficientNet-B0 disease prediction.
# Use "mock" for local development and "gemini" for the Gemini Vision API.
PART_DETECTION_MODE=mock
PART_DETECTION_MOCK_SCENARIO=Leaf
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/interactions
GEMINI_API_REVISION=2026-05-20
GEMINI_TIMEOUT_SECONDS=15
MAX_IMAGE_SIZE_MB=5
